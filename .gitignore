# ========================
# Unity Git Ignore
# ========================

# OS
.DS_Store
Thumbs.db

# Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/

# User-specific
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Crash and debug
*.stacktrace
*.dmp

# Visual Studio Code
.vscode/

# Rider
.idea/
*.sln.iml

# Autogenerated
Generated/
Assets/Plugins/Editor/JetBrains*

# Unity Addressable Assets
Assets/AddressableAssetsData/*/*.bin*

# Build pipeline cache
*.bak

# Android/iOS build
*.apk
*.aab
*.ipa

# Git LFS files (if using)
*.psd
*.fbx
*.wav
*.mp4
